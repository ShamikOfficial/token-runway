# TokenRunway — local (Floci) defaults
RUNWAY_ENV=local
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# DynamoDB / S3 / SNS names (seed script creates these)
RUNWAY_BUDGETS_TABLE=tokenrunway-budgets
RUNWAY_USAGE_TABLE=tokenrunway-usage
RUNWAY_FLIGHTS_TABLE=tokenrunway-flights
RUNWAY_AUDIT_TABLE=tokenrunway-audit
RUNWAY_META_TABLE=tokenrunway-meta
RUNWAY_RAW_BUCKET=tokenrunway-raw
RUNWAY_TOWER_TOPIC=tokenrunway-tower

# API
RUNWAY_API_HOST=0.0.0.0
RUNWAY_API_PORT=8000
RUNWAY_PRICING_OVERRIDES=samples/pricing_overrides.json
# Set to 1 only when iterating on mounted source inside Compose
RUNWAY_RELOAD=0

# Burn math
RUNWAY_EWMA_ALPHA=0.5
RUNWAY_BINGO_RESERVE_PCT=0.10
